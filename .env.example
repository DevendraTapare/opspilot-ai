# Run scripts/Initialize-Local.ps1 to create .env with generated local-only secrets.
# Never use this example token or these example credentials outside this simulator.
OPSPILOT_CONTROL_TOKEN=replace-with-a-random-token-of-at-least-32-characters
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=replace-with-generated-hex-password
POSTGRES_DB=opspilot
OPSPILOT_DATABASE_URL=postgresql+psycopg://opspilot:replace-with-generated-hex-password@127.0.0.1:55432/opspilot
OPSPILOT_API_PORT=8084
OPSPILOT_DB_PORT=55432
OPSPILOT_LOG_LEVEL=INFO

# Stage 2: run python -m scripts.initialize_gateway to append independent secrets.
# CALLERS is a JSON list of subject, token_sha256, services, and tool permissions.
# MCP receives CALLERS + DELEGATION_KEY only; never DB/approval/control credentials.
OPSPILOT_GATEWAY_CALLERS=[]
OPSPILOT_GATEWAY_DELEGATION_KEY=generate-an-independent-random-64-hex-value
OPSPILOT_GATEWAY_APPROVAL_KEY=generate-another-independent-random-64-hex-value
OPSPILOT_GATEWAY_DATABASE_URL=postgresql+psycopg://opspilot_gateway:replace-with-generated-hex-password@127.0.0.1:55432/opspilot
OPSPILOT_GATEWAY_DB_PASSWORD=generated-by-scripts.provision_gateway_db
OPSPILOT_GATEWAY_ACTIONS_ENABLED=false
OPSPILOT_MCP_READER_TOKEN=generated-reader-secret
OPSPILOT_MCP_CHECKOUT_TOKEN=generated-checkout-only-secret
OPSPILOT_MCP_OPERATOR_TOKEN=generated-operator-secret

# Stage 3: export these explicitly in the agent's PowerShell session.
# The agent deliberately does not auto-load this file or select a provider/model.
# No provider is installed or contacted in fixture mode.
# OPSPILOT_AGENT_PROVIDER=ollama
# OPSPILOT_AGENT_BASE_URL=http://127.0.0.1:11434
# OPSPILOT_AGENT_MODEL=your-installed-tool-and-json-schema-capable-model
# OPSPILOT_AGENT_API_KEY=optional-for-local-inference-required-by-remote-provider
# OpenAI-compatible alternative: provider=openai-compatible, base URL ending /v1.
# Agent CLI also requires OPSPILOT_MCP_TOKEN containing ONLY the reader token.
# Real smoke is opt-in: OPSPILOT_RUN_REAL_MODEL_SMOKE=1 plus
# OPSPILOT_AGENT_SMOKE_INCIDENT_ID=<an-existing-checkout-incident-uuid>.

# Stage 4 optional host test-database port (loopback only).
OPSPILOT_TEST_DB_PORT=55433
# After migrations: python -m scripts.initialize_durable
# This generates separate ignored .runner.env and .operator.env files.
# Never pass the operator file/key/token to the investigator or durable worker.
# The existing OPSPILOT_GATEWAY_ACTIONS_ENABLED=false default is preserved.

# Stage 5: optional local host tracing (not automatically forwarded into containers).
# OPSPILOT_TRACE_FILE=artifacts/local-traces.jsonl
# Exports only allowlisted metadata, adds a PID suffix, and never uses ambient OTLP.
# Benchmark runners automatically enable local traces and require the dedicated test DB.

# Stage 6: python -m scripts.initialize_dashboard provisions ignored .dashboard.env
# and frontend/.env.local. Never prefix service/DB/MCP/operator keys NEXT_PUBLIC_.
# Default UI origin: http://127.0.0.1:3000; API: http://127.0.0.1:8086.
# Existing gateway action flag remains false until explicitly enabled by an operator.
